{
  // Cloudflare Worker for the website. Build command `npm run build`, deploy command `npx wrangler deploy`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "balaji-web",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Send unknown paths (e.g. /projects, /admin) to index.html so React Router handles them.
    "not_found_handling": "single-page-application",
    // Every request goes to worker.js first (it serves /assets/* straight from ASSETS),
    // so it can forward /api, generate sitemap/robots and inject page metadata.
    "run_worker_first": true
  },
  // The balaji-api Worker must be deployed before this binding works.
  "services": [{ "binding": "API", "service": "balaji-api" }]
}
